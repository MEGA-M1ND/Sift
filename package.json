{
  "name": "sift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts",
    "check-fixture": "node --import tsx scripts/check-fixture.ts",
    "build": "vite build",
    "e2e": "node --import tsx scripts/e2e-panel.ts",
    "demo": "node --env-file-if-exists=.env --import tsx demo/server.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.20.3",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
